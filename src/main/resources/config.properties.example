# ============================================================
# Metrolink Backend - Database & App Configuration
# Copy this file to config.properties and fill in your values
# ============================================================

# MySQL Connection
db.url=jdbc:mysql://localhost:3306/metrolink_db?useSSL=false&serverTimezone=Asia/Manila&allowPublicKeyRetrieval=true
db.username=root
db.password=your_password_here
db.driver=com.mysql.cj.jdbc.Driver

# HikariCP Connection Pool
db.pool.maximumPoolSize=10
db.pool.minimumIdle=2
db.pool.connectionTimeout=30000
db.pool.idleTimeout=600000
db.pool.maxLifetime=1800000

# JWT Settings
jwt.secret=MetrolinkSuperSecretKey2025ChangeThisInProduction!
jwt.expirationMs=86400000

# App Settings
app.name=Metrolink FOMS
app.version=1.0.0
app.timezone=Asia/Manila
